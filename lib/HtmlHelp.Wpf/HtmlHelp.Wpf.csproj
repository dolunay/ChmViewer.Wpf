<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>HtmlHelp.Wpf</RootNamespace>
		<AssemblyName>HtmlHelp.Wpf</AssemblyName>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<UseWPF>true</UseWPF>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\HtmlHelp\HtmlHelp.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CefSharp.Wpf.NETCore" Version="144.0.120" />
		<PackageReference Include="chromiumembeddedframework.runtime.win-x64" Version="144.0.12" />
		<PackageReference Include="chromiumembeddedframework.runtime.win-x86" Version="144.0.12" />
	</ItemGroup>

</Project>
